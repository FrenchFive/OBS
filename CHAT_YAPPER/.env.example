# CHAT YAPPER settings - copy this file to ".env" and fill what you need.
# Everything here is OPTIONAL. Voice priority: ElevenLabs > OpenAI > Windows
# built-in voice > pyttsx3 (whichever has a working key/engine).

# ElevenLabs AI voices - key from https://elevenlabs.io -> profile -> API keys
ELEVENLABS_API_KEY=
# optional: your own voice ids, comma separated (one id = always that voice);
# leave empty to rotate through a few built-in ElevenLabs voices
ELEVENLABS_VOICE_IDS=
# optional: eleven_flash_v2_5 (fast/cheap, default) or eleven_multilingual_v2
ELEVENLABS_MODEL=

# OpenAI API key for the random gpt-4o-mini-tts voices
KEY_OPENAI=

# Where CHAT CONNECT is running (default is fine if it runs on the same PC)
CHAT_CONNECT_URL=ws://127.0.0.1:2428/ws

# OBS websocket (OBS > Tools > WebSocket Server Settings)
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
